NODE_ENV=production
DATABASE_URL=postgresql://sln:CHANGE_ME@postgres:5432/sln
DATABASE_SSL_MODE=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=false
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_RATE_LIMIT_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Suy Luan Nhi <no-reply@example.com>
STORAGE_DRIVER=s3
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_BUCKET=sln-production
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://cdn.example.com
PUBLIC_UPLOAD_BASE_URL=/uploads
LOCAL_UPLOAD_DIR=public/uploads
PARENT_GATE_TTL_MINUTES=30
PARENT_GATE_MAX_ATTEMPTS=5
PARENT_GATE_LOCK_MINUTES=15
CRON_SECRET=REPLACE_WITH_A_RANDOM_CRON_SECRET
LOG_LEVEL=info
