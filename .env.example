NODE_ENV=development
DATABASE_URL=postgresql://sln@127.0.0.1:54329/sln
DATABASE_SSL_MODE=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_STAFF_MFA_REQUIRED=true
# Google Cloud Console OAuth 2.0 Web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Suy Luận Nhí <no-reply@example.com>
STORAGE_DRIVER=local
# Set cloudinary after adding the credentials below
LOCAL_UPLOAD_DIR=public/uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sln-gpt
CLOUDINARY_UPLOAD_PRESET=
# Parent Gate timeouts and attempt limits are managed in Dashboard > Cấu hình hệ thống.
CRON_SECRET=

# SLN MCP Gateway
MCP_AUTH_MODE=token
MCP_API_TOKEN=
MCP_ACTOR_EMAIL=admin@demo.local
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_CORS_ORIGINS=
MCP_READ_ONLY=false
MCP_MAX_REMOTE_BYTES=10000000
MCP_REMOTE_TIMEOUT_MS=10000
MCP_RATE_LIMIT_PER_MINUTE=120
