# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit templates only)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser test artifacts
/test-results/
/playwright-report/
/blob-report/

# local uploads
/public/uploads/*
!/public/uploads/.gitkeep

/.verification/
/backups/
.env.production
# local agent/runtime scratch artifacts
/.scratch/db-backups/
/.scratch/dev-cache-stale-*/
/.scratch/playwright*.config.ts
# source reference bundle (must never be committed)
/starter/
